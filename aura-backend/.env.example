# ===============================
# Aura Music — Backend Config VPS
# Copiar este archivo como .env en el VPS
# NO subir .env real a Git (está en .gitignore)
# ===============================

HOST=0.0.0.0
PORT=8000

# MySQL en VPS Contabo
DB_HOST=localhost
DB_PORT=3306
DB_USER=aura_user
DB_PASSWORD=CAMBIA_ESTE_PASSWORD_SEGURO
DB_NAME=aura_music_db

# Ruta absoluta de descargas en el VPS
DOWNLOAD_DIR=/var/www/aura-music/downloads

# DuckDNS domain — permite CORS desde el frontend
FRONTEND_URL=http://aura-downloader.duckdns.org:3000
