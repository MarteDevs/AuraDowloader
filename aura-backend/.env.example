# ===============================
# Aura Music — Backend Config
# Copiar este archivo como .env y completar los valores
# NO subir .env real a Git (está en .gitignore)
# ===============================

# --- Servidor ---
HOST=0.0.0.0
PORT=8000

# --- Base de Datos MySQL ---
# En local: usa root con tu instalación local
# En VPS: usa el usuario y password de tu MySQL de Contabo
DB_HOST=localhost
DB_PORT=3306
DB_USER=aura_user
DB_PASSWORD=CAMBIA_ESTE_PASSWORD_SEGURO
DB_NAME=aura_music_db

# Opcionalmente puedes sobrescribir la URL completa:
# DATABASE_URL=mysql+pymysql://aura_user:PASSWORD@localhost:3306/aura_music_db

# --- Carpeta de descargas ---
# En VPS: ruta absoluta donde se guardarán los archivos de música
# Ejemplo: /home/tu_usuario/aura-downloads
DOWNLOAD_DIR=/var/www/aura-music/downloads

# --- CORS Frontend ---
# URL de tu dominio o IP del VPS donde corre el frontend
FRONTEND_URL=https://tu-dominio.com
