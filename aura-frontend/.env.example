# ===============================
# Aura Music — Frontend Config
# Copiar este archivo como .env y completar los valores
# NO subir .env real a Git (está en .gitignore)
# ===============================

# URL base del backend API (sin trailing slash)
# En local: http://localhost:8000
# En VPS: https://tu-dominio.com o http://IP_VPS:8000
VITE_API_BASE_URL=http://localhost:8000

# URL del WebSocket backend
# En local: ws://localhost:8000
# En VPS con HTTPS: wss://tu-dominio.com
VITE_WS_BASE_URL=ws://localhost:8000
